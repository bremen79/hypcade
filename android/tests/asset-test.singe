-- Synthetic integration fixture for the Android port; GPL-3.0-or-later.
-- Contains no commercial game code or artwork.
singeSetGameName("Android media test")
singeWantsCrosshairs(false)
discSetFPS(29.97)
colorBackground(0, 0, 0)
discSearch(0)
discPlay()
debugPrint("ANDROID_MEDIA_TEST START: Lua loaded")

-- Exercise real SDL image/font/WAV loaders against APK support assets.
local assetFont = fontLoad("fonts/default.ttf", 18)
local assetPng = spriteLoad("pics/tqkeys.png")
local assetBmp = spriteLoad("pics/led0.bmp")
local assetSound = soundLoad("sound/grumble.wav")
-- Verify SDL_mixer also sniffs the WAV header behind the compressed asset name.
local assetMusic = musicLoad("sound/hypcade-coin.wav")
assert(assetMusic >= 0)
assert(musicPlay(assetMusic) == assetMusic)
assert(musicIsPlaying(assetMusic))
debugPrint("ANDROID_APK_ASSETS PASS: SDL_mixer compressed WAV playing")
assert(assetFont >= 0 and assetPng >= 0 and assetBmp >= 0 and assetSound >= 0)
assert(soundPlay(assetSound) >= 0)
debugPrint("ANDROID_APK_ASSETS PASS: font PNG BMP WAV loaded; first play queued")

local reported = false
local lastInput = "Touch a control or use a gamepad"

function onOverlayUpdate()
    local frame = discGetFrame()
    overlayClear()
    overlayPrint(12, 15, "ANDROID 8 / MPEG-2 + VORBIS + LUA")
    overlayPrint(12, 40, "FRAME " .. tostring(frame))
    overlayPrint(12, 65, lastInput)
    if frame >= 60 and not reported then
        debugPrint("ANDROID_MEDIA_TEST PASS: playback advanced past frame 60")
        reported = true
        assert(soundPlay(assetSound) >= 0)
        debugPrint("ANDROID_APK_ASSETS PASS: cached sound replay queued")
    end
    if frame >= 270 then
        discSearch(0)
        discPlay()
    end
    return 1
end

function onInputPressed(key, mouse)
    lastInput = "PRESSED " .. tostring(key)
    debugPrint("ANDROID_MEDIA_TEST INPUT DOWN " .. tostring(key))
end

function onInputReleased(key, mouse)
    lastInput = "RELEASED " .. tostring(key)
    debugPrint("ANDROID_MEDIA_TEST INPUT UP " .. tostring(key))
end

function onShutdown()
    debugPrint("ANDROID_MEDIA_TEST SHUTDOWN")
end
