<?xml version="1.0" encoding="utf-8"?>
<!-- Legacy icon for API 25. Uses a compact foreground without adaptive-icon padding. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="108dp" android:height="108dp" />
            <corners android:radius="20dp" />
            <solid android:color="#160F0D" />
        </shape>
    </item>
    <item>
        <bitmap android:src="@drawable/ic_hypcade_legacy" android:gravity="fill"
            android:filter="true" />
    </item>
</layer-list>
